{
  "version": 2,
  "builds": [
    { "src": "frutillar/**", "use": "@vercel/static" },
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "exchange-auth-api.js", "use": "@vercel/node" },
    { "src": "exchange-p2p-cors-api.js", "use": "@vercel/node" },
    { "src": "exchange-p2p-api.js", "use": "@vercel/node" },
    { "src": "panos-api.js", "use": "@vercel/node" },
    { "src": "panos-api-v2.js", "use": "@vercel/node" },
    { "src": "panos-web-api.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/frutillar/?", "dest": "/frutillar/index.html" },
    { "src": "/frutillar/(.*)", "dest": "/frutillar/$1" },
    { "src": "/api/exchange/auth(?:/.*)?", "dest": "exchange-auth-api.js" },
    { "src": "/api/exchange/p2p(?:/.*)?", "dest": "exchange-p2p-cors-api.js" },
    { "src": "/api/panos/web/menu", "dest": "panos-web-api.js" },
    { "src": "/api/panos/[0-9]+/(?:documentos|historial)", "dest": "panos-web-api.js" },
    { "src": "/api/panos(?:/.*)?", "dest": "panos-api-v2.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
