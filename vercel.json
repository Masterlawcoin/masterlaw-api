{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "panos-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "panos-api-v2.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/panos(?:/.*)?",
      "dest": "panos-api-v2.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
