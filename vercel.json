{
  "version": 2,
  "builds": [
    {
      "src": "frutillar/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "panos-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "panos-api-v2.js",
      "use": "@vercel/node"
    },
    {
      "src": "panos-web-api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/frutillar/?",
      "dest": "/frutillar/index.html"
    },
    {
      "src": "/frutillar/(.*)",
      "dest": "/frutillar/$1"
    },
    {
      "src": "/api/panos/web/menu",
      "dest": "panos-web-api.js"
    },
    {
      "src": "/api/panos/[0-9]+/(?:documentos|historial)",
      "dest": "panos-web-api.js"
    },
    {
      "src": "/api/panos(?:/.*)?",
      "dest": "panos-api-v2.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
